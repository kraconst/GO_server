# Server
HTTP_ADDR=:8080

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=telecorp
DB_PASSWORD=telecorp_secret
DB_NAME=telecorp_db
DB_SSLMODE=disable

# Telegram Development CLI (cmd/telegram-dev)
# Example only: the CLI reads process environment, not this file automatically.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Use a different session file for each account.
TELEGRAM_SESSION_PATH=./var/telegram/account-a.session
